# Copy to .env and fill in values yourself. Never commit .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CONFLUENCE_BASE_URL=https://lessen.atlassian.net/wiki
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
# Space KEYS (from the page URL: /wiki/spaces/<KEY>/...)
ALLOWED_SPACES=VendorSaaS,TCN
# passcode or cloudflare
AUTH_MODE=passcode
# Only used when AUTH_MODE=passcode
APP_PASSCODE=
# Page ID of the "Documentation Requests" table (the only page the bot may write to)
DOCS_REQUEST_PAGE_ID=3972071438
# Optional: starter questions separated by |
SUGGESTED_QUESTIONS=

# Optional: monthly Claude budget in USD, shown on the Usage page
ANTHROPIC_MONTHLY_BUDGET=
# Jira projects the Product chat may search (read-only). Default: LP
JIRA_PROJECTS=LP
# Optional: starter questions for the Product chat, separated by |
SUGGESTED_QUESTIONS_PRODUCT=
# --- User feedback chat ---
# Notion internal integration secret (read-only). Share the User Research page with the integration.
NOTION_TOKEN=
NOTION_ROOT_PAGE_ID=328878319aeb80f1839ffb8a08f4a609
# Confluence page the daily task copies Lessen Pro Feedback.xlsx into
FEEDBACK_PAGE_ID=3971678223
# Jira projects the User feedback chat may search
JIRA_PROJECTS_FEEDBACK=LP,LPH
SUGGESTED_QUESTIONS_FEEDBACK=
# --- Storage (optional) ---
# Railway sets this when you link a Postgres database. Leave empty locally to run without a database.
DATABASE_URL=
# Question/answer text is cleared after this many days (counts and costs are kept)
RETENTION_DAYS=365
