# Copy to .env and fill in values yourself. Never commit .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CONFLUENCE_BASE_URL=https://lessen.atlassian.net/wiki
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
# Space KEYS (from the page URL: /wiki/spaces/<KEY>/...)
ALLOWED_SPACES=VendorSaaS,TCN
